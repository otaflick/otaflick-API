{
    "$schema": "https://railway.com/railway.schema.json",
    "build": {
      "builder": "RAILPACK"
    },
    "deploy": {
      "runtime": "Node",
      "numReplicas": 1,
      "sleepApplication": false,
      "useLegacyStacker": false,
      "multiRegionConfig": {
        "us-east4-eqdc4a": {
          "numReplicas": 1
        }
      },
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 10
    },
    "startCommand": "npm install && npm run dev"
  }
  